# Polar AccessLink OAuth2 credentials.
# Copy to .env, fill in real values, then `set -a && source .env && set +a`
# DO NOT commit .env — it's git-ignored.
POLAR_CLIENT_ID=your_client_id_here
POLAR_CLIENT_SECRET=your_client_secret_here

# Optional: passed to the ride analyzer
# RIDER_WEIGHT_KG=80
# FTP_W=226
